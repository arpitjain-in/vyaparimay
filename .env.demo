# ─── Demo / Sanity-Testing Mode ──────────────────────────────────────────────
# Loaded automatically by Vite when you run:  npm run dev:demo
#   (which passes --mode demo → Vite reads .env.demo)
#
# SAFETY GUARANTEES:
#   1. VITE_DEMO_MODE=true  → supabase.ts creates an inert client pointing at
#      127.0.0.1:0 (connection always refused). No real DB call can succeed.
#   2. autoRefreshToken / persistSession disabled → no auth refresh calls.
#   3. All store writes go through db.demo.ts (localStorage only).
#   4. AuthPage is never rendered; OTP flow never runs.
#
# Your real .env credentials are NOT loaded when this mode is active.
# ─────────────────────────────────────────────────────────────────────────────

VITE_DEMO_MODE=true

# These values intentionally do NOT match production.
# supabase.ts ignores them entirely when VITE_DEMO_MODE=true.
VITE_SUPABASE_URL=http://127.0.0.1:0
VITE_SUPABASE_ANON_KEY=demo-mode-no-real-key
